            <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap:14px;">
              <div class="ops-pipeline-card">
                <div class="metric-header"><span class="metric-label">CPU ARCHITECTURE & FREQUENCY</span></div>
                <div style="font-family:var(--font-mono); font-size:13px; color:#e0f7fa; line-height:1.6; margin-top:8px;">
                  <div>• Host Platform: Windows 11 Pro 64-bit</div>
                  <div>• Core Matrix: 16 Logical Threads</div>
                  <div>• Current Clock: Dynamic Frequency Scaling</div>
                  <div>• Sampling Frequency: 2 Hz (Every 500ms)</div>
                </div>
              </div>

              <div class="ops-pipeline-card">
                <div class="metric-header"><span class="metric-label">LOCAL RUNTIME PORTS</span></div>
                <div style="font-family:var(--font-mono); font-size:13px; color:#e0f7fa; line-height:1.6; margin-top:8px;">
                  <div>• FastAPI Server: Port 8000 (Active)</div>
                  <div>• OmniRoute Gateway: Port 20128 (Connected)</div>
                  <div>• Chrome Remote Debug: Isolated Profile</div>
                  <div>• WebSocket Transports: /ws/chat, /ws/telemetry</div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- WORKSPACE 9: SETTINGS & PROTOCOLS -->
        <div class="workspace-view" id="workspaceSettings">
          <div class="workspace-page">
            <div class="workspace-header-bar">
              <div class="workspace-title-group">
                <span class="workspace-title">⚙️ SETTINGS & PROTOCOLS</span>
                <span class="workspace-tag">CORE OPERATING SYSTEM CONFIGURATION</span>
              </div>
              <button class="hud-btn" id="btnSaveConfig" style="border-color:#38ef7d; color:#38ef7d; font-weight:700;">COMMIT SETTINGS</button>
            </div>

            <div style="max-width:700px; background:var(--hud-panel-bg); border:1px solid var(--hud-border); border-radius:var(--radius-md); padding:18px;">
              <div class="form-group">
                <label class="form-label">ANTIGRAVITY WORKSPACE LINK</label>
                <div style="font-family: var(--font-mono); font-size: 12px; color: #00e5ff; padding: 4px 0; display:flex; align-items:center; gap:8px;">
                  <span style="display:inline-block; width:8px; height:8px; border-radius:50%; background:#00e5ff; box-shadow:0 0 8px #00e5ff;"></span>
                  CONNECTED DIRECTLY TO ANTIGRAVITY (NO API KEY REQUIRED)
                </div>
                <small class="form-help">Jarvis is natively connected to your Google Antigravity project workspace. System automation, memory vault, and PC controls are fully active.</small>
              </div>

              <div class="form-group" style="margin-top:14px;">
                <label class="form-label">OPTIONAL CLOUD GEMINI KEY (OPTIONAL)</label>
                <input type="password" class="hud-input" id="cfgApiKey" placeholder="Optional external Gemini Key">
                <small class="form-help">Optional: Only if you wish to link an external cloud model. Local Antigravity matrix is already active.</small>
              </div>

              <div class="form-group" style="margin-top:14px;">
                <label class="form-label">SYNTHETIC VOICE ENGINE PRESET</label>
                <select class="hud-select" id="cfgVoiceSelect"></select>
              </div>

              <div class="form-group" style="margin-top:14px;">
                <label class="form-label">AUDIO SOUND EFFECTS</label>
                <label class="hud-toggle">
                  <input type="checkbox" id="cfgSoundFx" checked>
                  <span class="toggle-slider"></span>
                  <span class="toggle-text">Enable Sci-Fi Synthetic Chimes & Feedback</span>
                </label>
              </div>
            </div>
          </div>
        </div>

      </main>
    </div>

  </div>

  <!-- GLOBAL OVERLAY 1: COMMAND PALETTE (CTRL+K) -->
  <div class="cmd-palette-backdrop" id="cmdPaletteModal">
    <div class="cmd-palette-modal">
      <div class="cmd-palette-header">
        <span class="cmd-palette-search-icon">🔍</span>
        <input type="text" class="cmd-palette-input" id="inpCmdPalette" placeholder="Type a command or jump to workspace..." autocomplete="off">
        <span class="cmd-palette-esc">ESC</span>
      </div>
      <div class="cmd-palette-results" id="cmdPaletteResults">
        <!-- Injected dynamically via hud.js -->
      </div>
    </div>
  </div>

  <!-- GLOBAL OVERLAY 2: NOTIFICATION DRAWER -->
  <aside class="notification-drawer" id="notificationDrawer" aria-label="Notifications Center">
    <div class="notification-header">
      <div style="display:flex; align-items:center; gap:8px;">
        <span style="color:#00e5ff; font-size:16px;">🔔</span>
        <span style="font-family:var(--font-display); font-size:13px; font-weight:700; color:#00e5ff;">NOTIFICATIONS</span>
      </div>
      <div style="display:flex; gap:6px;">
        <button class="hud-btn" id="btnClearNotifications" style="padding:2px 8px; font-size:10px;">CLEAR</button>
        <button class="modal-close" id="btnCloseNotifications" style="font-size:14px; cursor:pointer;">✕</button>
      </div>
    </div>
    <div class="notification-list" id="notificationList">
      <div class="notification-item">
        <div>J.A.R.V.I.S. neural matrix initialized. All systems nominal.</div>
        <div class="notification-time">System Startup</div>
      </div>
    </div>
  </aside>

  <!-- GLOBAL OVERLAY 3: TOAST CONTAINER -->
  <div class="toast-container" id="toastContainer" aria-live="polite"></div>

  <!-- GLOBAL OVERLAY 4: HUMAN APPROVAL GATE MODAL -->
  <div class="modal-overlay" id="approvalModal">
    <div class="modal-card approval-card" style="max-width:540px; border-color:#ffaa00; box-shadow:0 0 35px rgba(255,170,0,0.35);">
      <div class="modal-header" style="border-bottom:1px solid rgba(255,170,0,0.4);">
        <div style="display:flex; align-items:center; gap:8px;">
          <span style="font-size:22px;">⚠️</span>
          <div>
            <span class="modal-title" style="color:#ffaa00;">DIRECTIVE AUTHORIZATION REQUIRED</span>
            <div style="font-size:10px; font-family:var(--font-mono); color:#ffdd80;">SECURITY GOVERNANCE & SAFETY GATE</div>
          </div>
        </div>
        <button class="modal-close" id="btnCloseApproval">✕</button>
      </div>
      <div class="modal-body" style="padding:16px;">
        <div style="font-size:12px; font-family:var(--font-mono); margin-bottom:12px; color:#e0f7fa;">
          Sir Shakil, this action has been classified as high-consequence. Your explicit authorization is required to proceed.
        </div>
        <div id="approvalTaskDetails" style="background:rgba(255,170,0,0.08); border-left:3px solid #ffaa00; padding:12px; font-family:var(--font-mono); font-size:12px; margin-bottom:16px; color:#fff; border-radius:2px;">
          <!-- Populated dynamically -->
        </div>
        <div style="display:flex; gap:12px; justify-content:flex-end;">
          <button class="hud-btn" id="btnRejectApproval" style="border-color:#ff3344; color:#ff3344; background:rgba(255,51,68,0.12);">ABORT DIRECTIVE</button>
          <button class="hud-btn" id="btnAuthorizeApproval" style="border-color:#38ef7d; color:#38ef7d; background:rgba(56,239,125,0.18); font-weight:700;">AUTHORIZE DIRECTIVE</button>
        </div>
      </div>
    </div>
  </div>

  <!-- GLOBAL OVERLAY 5: SCREENSHOT PREVIEW MODAL -->
  <div class="modal-overlay" id="screenModal">
    <div class="modal-card screen-card">
      <div class="modal-header">
        <span class="modal-title">VISUAL CAPTURE TELEMETRY</span>
        <button class="modal-close" id="btnCloseScreen">✕</button>
      </div>
      <div class="modal-body screen-body">
        <img id="screenPreviewImg" src="" alt="Capture Preview">
      </div>
    </div>
  </div>

  <script src="/static/hud.js?v=mark16_advanced_os"></script>
</body>
</html>
