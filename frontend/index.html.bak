<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>J.A.R.V.I.S. // Shakil's Assistant</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700;800;900&family=Rajdhani:wght@500;600;700&family=Share+Tech+Mono&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/hud.css?v=mark16_advanced_os">
  <style>
    /* RESPONSIVE HUD STYLING */
    html, body { 
        margin: 0; 
        padding: 0; 
        height: 100vh;
        background-color: #040810;
        overflow: hidden;
    }
    .hud-container {
        height: 100vh;
        box-sizing: border-box;
        border: 1px solid rgba(0, 240, 255, 0.25);
        position: relative;
        display: flex;
        flex-direction: column;
    }
    .hud-header {
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 8px 14px;
        gap: 12px;
        z-index: 60;
    }
    .header-right {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        align-items: center;
        justify-content: flex-end;
    }
    .hud-btn {
        padding: 5px 10px;
        font-size: 11px;
        white-space: nowrap;
        letter-spacing: 0.8px;
    }
    .hud-main {
        flex: 1;
        min-height: 0;
    }
  </style>
</head>
<body>
  <!-- Cyber Scanline Overlay -->
  <div class="scanlines"></div>
  <div class="grid-bg"></div>

  <!-- Main Container -->
  <div class="hud-container">
    
    <!-- TOP HEADER -->
    <header class="hud-header">
      <div class="hud-corner top-left"></div>
      <div class="hud-corner top-right"></div>
      
      <div class="header-left">
        <div class="brand-title">
          <span class="stark-logo">STARK IND</span>
          <span class="brand-text">J.A.R.V.I.S. <span class="accent">//</span> MARK XVI</span>
        </div>
        <div class="sys-badges">
          <span class="badge" id="badgeCore"><span class="dot"></span> CORE: ONLINE</span>
          <span class="badge" id="badgeWs"><span class="dot"></span> LINK: SYNCED</span>
          <span class="badge" id="badgeVoice"><span class="dot"></span> VOICE: en-GB</span>
          <span class="badge" id="badgeEvolution"><span class="dot" style="background:#ffaa00; box-shadow:0 0 8px #ffaa00;"></span> EVOLUTION: LVL 2 (4 NODES)</span>
          <span class="badge badge-antigravity" id="badgeAntigravity" title="Google Antigravity SDK & Agent Runtime"><span class="dot" style="background:#00e5ff; box-shadow:0 0 8px #00e5ff;"></span> ANTIGRAVITY: CONNECTED</span>
          <span class="badge badge-omniroute" id="badgeOmniroute" title="OmniRoute Free Multi-Model Intelligence Gateway"><span class="dot" style="background:#76ff03; box-shadow:0 0 8px #76ff03;"></span> OMNIROUTE: 1,189+ MODELS</span>
          <span class="badge" id="badgeGateway" title="Model Gateway Circuit Breaker & Health"><span class="dot" style="background:#38ef7d; box-shadow:0 0 8px #38ef7d;"></span> GATEWAY: ONLINE</span>
          <span class="badge" id="badgeBrowserProfile" title="Dedicated Chrome Profile Named 'Jarvis'"><span class="dot" style="background:#00e5ff; box-shadow:0 0 8px #00e5ff;"></span> CHROME: JARVIS</span>
          <span class="badge" id="badgeMicStatus"><span class="dot" style="background:#00e5ff; box-shadow:0 0 8px #00e5ff;"></span> MIC: LISTENING</span>
          <span class="badge" id="badgeTasks" title="Master Orchestrator Concurrency Guard"><span class="dot" style="background:#38ef7d; box-shadow:0 0 8px #38ef7d;"></span> TASKS: 0/2</span>
        </div>
      </div>

      <div class="header-center" style="display:flex; flex-direction:column; align-items:center; gap:2px;">
        <div style="display:flex; align-items:center; gap:8px;">
          <span id="currentWorkspaceHeaderBadge" class="workspace-tag" style="background:rgba(0,240,255,0.15); border-color:#00f0ff; color:#00f0ff; font-weight:700;">COMMAND CENTER</span>
          <div class="hud-clock" id="hudClock">00:00:00</div>
        </div>
        <div class="hud-date" id="hudDate">INITIALIZING...</div>
      </div>

      <div class="header-right">
        <!-- Workspace Selector -->
        <div class="workspace-selector-wrap" style="display:inline-flex; align-items:center; gap:4px;">
          <span style="font-family:'Rajdhani',sans-serif; font-size:11px; color:#00e5ff; font-weight:700;">WORKSPACE:</span>
          <select id="selWorkspace" class="hud-select" style="background:#06141d; border:1px solid #00e5ff; color:#00e5ff; font-family:'Share Tech Mono',monospace; font-size:11px; padding:3px 6px; border-radius:3px; outline:none; cursor:pointer;" title="Select Isolated Workspace Context">
            <option value="personal" selected>🏠 PERSONAL</option>
            <option value="agency">💼 AGENCY</option>
            <option value="crypto">📈 CRYPTO</option>
            <option value="saas">🚀 SAAS</option>
            <option value="systems">⚙️ SYSTEMS</option>
            <option value="research">🔬 RESEARCH</option>
          </select>
        </div>

        <!-- Global Action Triggers -->
        <button class="hud-btn" id="btnOpenCmdPalette" style="border-color:#00e5ff; color:#00e5ff; background:rgba(0,229,255,0.1);" title="Command Palette (Ctrl+K)">🔍 COMMANDS (Ctrl+K)</button>
        <button class="hud-btn" id="btnOpenNotifications" style="border-color:rgba(0,229,255,0.4); color:#e0f7fa;" title="Notifications & System Alerts">🔔 <span id="notificationBadgeCount" style="color:#00e5ff; font-weight:700;">0</span></button>
        <button class="hud-btn" id="btnEmergencyAbort" style="border-color:#ff3344; background:rgba(255,51,68,0.25); color:#ff3344; font-weight:800;" title="Instant Hard Abort (<100ms) - [Esc]">🛑 ABORT</button>
        <button class="hud-btn" id="btnOpenArtifactsFolder" style="border-color:#38ef7d; color:#38ef7d;" title="Open Desktop\Jarvis_Created_Files in Windows Explorer">📂 ARTIFACTS</button>
        <button class="hud-btn" id="btnTestVoice" style="border-color:#38ef7d; color:#38ef7d;" title="Test Neural Voice & PC Speakers">🔊 TEST VOICE</button>
        <button class="hud-btn" id="btnFullscreen" title="Fullscreen HUD">⛶ FULLSCREEN</button>

        <!-- Legacy Quick Action Selectors (Linked to Workspaces) -->
        <button class="hud-btn" id="btnOpenDedicatedChat" style="display:none;" title="Chat"></button>
        <button class="hud-btn" id="btnSpecialistsDeck" style="display:none;" title="Specialists"></button>
        <button class="hud-btn" id="btnBrowserResearchHeader" style="display:none;" title="Research"></button>
        <button class="hud-btn" id="btnMarketingHub" style="display:none;" title="Marketing"></button>
        <button class="hud-btn" id="btnJarvisBrowser" style="display:none;" title="Browser"></button>
        <button class="hud-btn" id="btnMemoryVault" style="display:none;" title="Memory"></button>
        <button class="hud-btn" id="btnDiagnostics" style="display:none;" title="Diagnostics"></button>
        <button class="hud-btn" id="btnSettings" style="display:none;" title="Config"></button>
      </div>
    </header>

    <!-- APPLICATION SHELL: NAVIGATION RAIL + MAIN VIEWPORT -->
    <div class="app-shell">
      
      <!-- EXPANDABLE NAVIGATION RAIL -->
      <nav class="nav-rail" id="mainNavRail" aria-label="J.A.R.V.I.S. Workspaces">
        <div class="nav-rail-top">
          <!-- Rail Expansion Toggle -->
          <button class="nav-rail-toggle-btn" id="btnToggleRail" title="Toggle Navigation Rail (Alt+M)" aria-label="Toggle Navigation Rail">
            <span class="nav-rail-icon">☰</span>
          </button>
          
          <div class="nav-rail-list">
            <div class="nav-rail-item active" data-workspace="command_center" data-tooltip="Command Center (Alt+1)" tabindex="0" role="button">
              <span class="nav-rail-icon">🏠</span>
              <span class="nav-rail-label">Command Center</span>
              <span class="nav-rail-shortcut">Alt+1</span>
            </div>

            <div class="nav-rail-item" data-workspace="chat" data-tooltip="Neural Conversation (Alt+2)" tabindex="0" role="button">
              <span class="nav-rail-icon">💬</span>
              <span class="nav-rail-label">Neural Chat</span>
              <span class="nav-rail-shortcut">Alt+2</span>
            </div>

            <div class="nav-rail-item" data-workspace="agents" data-tooltip="Agent Network (Alt+3)" tabindex="0" role="button">
              <span class="nav-rail-icon">🤖</span>
              <span class="nav-rail-label">Agent Network</span>
              <span class="nav-rail-shortcut">Alt+3</span>
            </div>

            <div class="nav-rail-item" data-workspace="operations" data-tooltip="Operations Center (Alt+4)" tabindex="0" role="button">
              <span class="nav-rail-icon">⚡</span>
              <span class="nav-rail-label">Operations & Tasks</span>
              <span class="nav-rail-shortcut">Alt+4</span>
            </div>

            <div class="nav-rail-item" data-workspace="research" data-tooltip="Research & Intel (Alt+5)" tabindex="0" role="button">
              <span class="nav-rail-icon">🌐</span>
              <span class="nav-rail-label">Research & Intel</span>
              <span class="nav-rail-shortcut">Alt+5</span>
            </div>

            <div class="nav-rail-item" data-workspace="marketing" data-tooltip="Marketing & Wealth (Alt+6)" tabindex="0" role="button">
              <span class="nav-rail-icon">📣</span>
              <span class="nav-rail-label">Marketing Hub</span>
              <span class="nav-rail-shortcut">Alt+6</span>
            </div>

            <div class="nav-rail-item" data-workspace="memory" data-tooltip="Memory Vault (Alt+7)" tabindex="0" role="button">
              <span class="nav-rail-icon">🧠</span>
              <span class="nav-rail-label">Memory Vault</span>
              <span class="nav-rail-shortcut">Alt+7</span>
            </div>

            <div class="nav-rail-item" data-workspace="diagnostics" data-tooltip="System Monitor (Alt+8)" tabindex="0" role="button">
              <span class="nav-rail-icon">💻</span>
              <span class="nav-rail-label">System Diagnostics</span>
              <span class="nav-rail-shortcut">Alt+8</span>
            </div>
          </div>
        </div>

        <div class="nav-rail-bottom">
          <div class="nav-rail-item" data-workspace="settings" data-tooltip="Settings & Protocols (Alt+9)" tabindex="0" role="button">
            <span class="nav-rail-icon">⚙️</span>
            <span class="nav-rail-label">Settings</span>
            <span class="nav-rail-shortcut">Alt+9</span>
          </div>
        </div>
      </nav>

      <!-- MAIN WORKSPACE VIEWPORT -->
      <main class="main-viewport" id="mainViewport">
        
        <!-- WORKSPACE 1: COMMAND CENTER (PRIMARY HUD) -->
        <div class="workspace-view active" id="workspaceCommandCenter">
          <div class="hud-main" style="display:flex; flex:1; min-height:0;">
            
            <!-- LEFT PANEL: SYSTEM TELEMETRY -->
            <section class="hud-panel left-panel">
              <div class="panel-header">
                <span class="panel-title">TELEMETRY MATRIX</span>
                <span class="panel-tag">SYS.DIAG.01</span>
              </div>

              <!-- CPU GAUGE -->
              <div class="telemetry-block">
                <div class="gauge-row">
                  <div class="circular-gauge">
                    <svg viewBox="0 0 100 100">
                      <circle class="gauge-bg" cx="50" cy="50" r="42"></circle>
                      <circle class="gauge-bar cpu-bar" id="cpuCircle" cx="50" cy="50" r="42"></circle>
                    </svg>
                    <div class="gauge-value">
                      <span id="cpuPercent">0</span><small>%</small>
                    </div>
                  </div>
                  <div class="gauge-details">
                    <div class="metric-label">CPU CORE LOAD</div>
                    <div class="metric-sub" id="cpuFreq">0 MHz · 16 Cores</div>
                    <div class="core-bars" id="coreBarsContainer"></div>
                  </div>
                </div>
              </div>

              <!-- RAM GAUGE -->
              <div class="telemetry-block">
                <div class="metric-header">
                  <span class="metric-label">PHYSICAL RAM</span>
                  <span class="metric-num" id="ramDetail">0 / 0 GB</span>
                </div>
                <div class="progress-bar-container">
                  <div class="progress-bar-fill" id="ramProgressFill"></div>
                </div>
                <div class="metric-sub" id="ramPercentLabel">ALLOCATION: 0%</div>
              </div>

              <!-- STORAGE GAUGES -->
              <div class="telemetry-block">
                <div class="metric-header">
                  <span class="metric-label">STORAGE VOLUMES</span>
                </div>
                <div id="diskContainer" class="disk-list"></div>
              </div>

              <!-- NETWORK SPEED GAUGES -->
              <div class="telemetry-block">
                <div class="metric-header">
                  <span class="metric-label">NETWORK I/O BANDWIDTH</span>
                </div>
                <div class="net-grid">
                  <div class="net-stat">
                    <span class="net-icon">▲ UP</span>
                    <span class="net-val" id="netUp">0.0 KB/s</span>
                  </div>
                  <div class="net-stat">
                    <span class="net-icon">▼ DOWN</span>
                    <span class="net-val" id="netDown">0.0 KB/s</span>
                  </div>
                </div>
              </div>

              <!-- UPTIME & SYSTEM HEALTH -->
              <div class="telemetry-block">
                <div class="metric-header">
                  <span class="metric-label">SYSTEM UPTIME</span>
                  <span class="metric-num" id="uptimeLabel">00:00:00</span>
                </div>
              </div>
            </section>

            <!-- CENTER STAGE: ARC REACTOR CORE & VOICE INTERACTION -->
            <section class="center-stage">
              <div class="reactor-wrapper">
                <canvas id="arcCanvas" width="560" height="560"></canvas>
                <div class="reactor-overlay-data">
                  <div class="core-status" id="coreStatusLabel">ONLINE</div>
                  <div class="core-subtext" id="coreSubtext">AWAITING DIRECTIVE</div>
                </div>
              </div>

              <!-- VOICE & CONTROL DOCK -->
              <div class="voice-dock">
                <button class="voice-trigger-btn" id="btnVoiceToggle" title="Click to Speak or Toggle Continuous Listening">
                  <div class="mic-glow-ring"></div>
                  <div class="mic-icon" id="micIcon">
                    <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor">
                      <path d="M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3z"/>
                      <path d="M17 11c0 2.76-2.24 5-5 5s-5-2.24-5-5H5c0 3.53 2.61 6.43 6 6.92V21h2v-3.08c3.39-.49 6-3.39 6-6.92h-2z"/>
                    </svg>
                  </div>
                </button>
                
                <div class="voice-options">
                  <label class="hud-toggle">
                    <input type="checkbox" id="chkContinuousVoice" checked>
                    <span class="toggle-slider"></span>
                    <span class="toggle-text">ALWAYS-ON LISTENING</span>
                  </label>
                  <label class="hud-toggle">
                    <input type="checkbox" id="chkWakeWord">
                    <span class="toggle-slider"></span>
                    <span class="toggle-text">REQUIRE "JARVIS" WAKE-WORD</span>
                  </label>
                  <div class="accent-picker-row" style="margin-top:6px; display:flex; align-items:center; gap:6px;">
                    <span style="font-family:var(--font-mono); font-size:10px; color:#00e5ff;">ACCENT:</span>
                    <select class="hud-select" id="selSpeechLang" style="font-size:11px; padding:3px 8px; width:auto; border-color:rgba(0,229,255,0.4);">
                      <option value="en-IN" selected>South Asian English (en-IN) · Recommended</option>
                      <option value="en-US">US English (en-US)</option>
                      <option value="en-GB">UK English (en-GB)</option>
                      <option value="bn-BD">বাংলা / Bengali (bn-BD)</option>
                    </select>
                  </div>
                  <div class="audio-mode-row" style="margin-top:6px; display:flex; align-items:center; gap:6px;">
                    <span style="font-family:var(--font-mono); font-size:10px; color:#00e5ff;">AUDIO ROUTE:</span>
                    <select class="hud-select" id="selAudioMode" style="font-size:11px; padding:3px 8px; width:auto; border-color:rgba(0,229,255,0.4);">
                      <option value="browser" selected>Browser Audio (Active Device · Mobile / PC)</option>
                      <option value="speaker">Host PC Hardware Speakers (Direct Kernel)</option>
                    </select>
                  </div>
                  <div class="model-picker-row" style="margin-top:6px; display:flex; align-items:center; gap:6px;">
                    <span style="font-family:var(--font-mono); font-size:10px; color:#38ef7d;">AI BRAIN:</span>
                    <select class="hud-select" id="selMainModel" style="font-size:11px; padding:3px 8px; width:auto; border-color:rgba(56,239,125,0.5); color:#38ef7d;">
                      <option value="agy/gemini-3.8-flash-high">⚡ Antigravity: Gemini 3.8 Flash High</option>
                      <option value="agy/gemini-3.7-flash-low" selected>⚡ Antigravity: Gemini 3.7 Flash</option>
                      <option value="agy/claude-sonnet-4-6">🧠 Antigravity: Claude Sonnet 4.6</option>
                      <option value="agy/claude-opus-4-6-thinking">🔮 Antigravity: Claude Opus 4.6 Thinking</option>
                      <option value="agy/gemini-pro-agent">🤖 Antigravity: Gemini Pro Agent</option>
                      <option value="agy/gpt-oss-120b-medium">🌐 Antigravity: GPT-OSS 120B</option>
                      <option value="auto/best-reasoning">🧭 OmniRoute: Deep Reasoning</option>
                      <option value="auto/chat">⚡ OmniRoute: Auto Fast Chat</option>
                      <option value="local/autonomous">🛡️ Local Autonomous Brain (Zero Keys)</option>
                    </select>
                  </div>
                </div>
              </div>

              <!-- ACTIVE APPLICATION BADGE -->
              <div class="active-app-dock">
                <span class="app-dock-label">FOREGROUND FOCUS:</span>
                <span class="app-dock-name" id="activeWindowTitle">DESKTOP</span>
              </div>
            </section>

            <!-- RIGHT PANEL: MISSION CONTROL & RUNTIME AUTOMATION -->
            <section class="hud-panel right-panel">
              <div class="panel-header">
                <span class="panel-title">MISSION CONTROL</span>
                <span class="panel-tag">SYS.AUTO.02</span>
              </div>

              <!-- QUICK LAUNCH ACTIONS -->
              <div class="telemetry-block">
                <div class="metric-header">
                  <span class="metric-label">APPLICATION DISPATCH</span>
                </div>
                <div class="quick-app-grid">
                  <button class="quick-btn" id="btnQuickJarvisChrome" style="border-color: #00e5ff; color: #00e5ff;">JARVIS CHROME</button>
                  <button class="quick-btn" id="btnQuickCheckEmails" style="border-color: #76ff03; color: #76ff03;">CHECK EMAILS</button>
                  <button class="quick-btn" id="btnQuickEventbrite" style="border-color: #ff9100; color: #ff9100;">EVENTBRITE</button>
                  <button class="quick-btn" id="btnQuickMarketingHub" style="border-color: #ff0055; color: #ff0055;">ADS ENGINE</button>
                  <button class="quick-btn" data-action="launch" data-target="chrome">CHROME</button>
                  <button class="quick-btn" data-action="launch" data-target="code">VS CODE</button>
                  <button class="quick-btn" data-action="launch" data-target="terminal">TERMINAL</button>
                  <button class="quick-btn" data-action="launch" data-target="taskmgr">TASK MGR</button>
                </div>
              </div>

              <!-- HARDWARE CONTROL DECK -->
              <div class="telemetry-block">
                <div class="metric-header">
                  <span class="metric-label">AUDIO & POWER CONTROLS</span>
                </div>
                <div class="slider-group">
                  <div class="slider-row">
                    <span class="slider-label">MASTER VOL:</span>
                    <span class="slider-val" id="volumeDisplay">100%</span>
                  </div>
                  <input type="range" class="hud-range" id="volumeSlider" min="0" max="100" value="100">
                </div>
                <div class="quick-app-grid" style="margin-top: 10px;">
                  <button class="quick-btn" id="btnMuteToggle">MUTE</button>
                  <button class="quick-btn" id="btnMediaPlay">PLAY/PAUSE</button>
                  <button class="quick-btn" id="btnScreenshot">CAPTURE</button>
                  <button class="quick-btn danger-btn" id="btnLockPc">LOCK PC</button>
                </div>
              </div>

              <!-- TOP RESOURCE CONSUMING PROCESSES -->
              <div class="telemetry-block">
                <div class="metric-header">
                  <span class="metric-label">TOP PROCESS MATRIX</span>
                </div>
                <div class="process-table" id="processTable"></div>
              </div>

              <!-- ORCHESTRATOR TASK PIPELINE & SAFETY MONITOR -->
              <div class="telemetry-block">
                <div class="metric-header">
                  <span class="metric-label">ORCHESTRATOR PIPELINE</span>
                  <span class="metric-num" id="taskPipelineSummary">0 ACTIVE · 0 WAITING</span>
                </div>
                <div class="pipeline-list" id="orchestratorPipelineDeck" style="font-family:var(--font-mono); font-size:11px; max-height:130px; overflow-y:auto; line-height:1.4; color:#e0f7fa; padding:4px 0;">
                  <div style="opacity:0.6;">All systems nominal. Ready for directives.</div>
                </div>
              </div>
            </section>

          </div>

          <!-- BOTTOM DECK: NEURAL TERMINAL & VOICE RECOGNITION CONSOLE -->
          <footer class="hud-footer">
            <div class="hud-corner bottom-left"></div>
            <div class="hud-corner bottom-right"></div>
            
            <!-- TERMINAL LOG FEED -->
            <div class="terminal-feed" id="terminalFeed">
              <div class="log-line info">
                <span class="log-time">[00:00:00]</span>
                <span class="log-sender">SYSTEM:</span>
                <span class="log-text">J.A.R.V.I.S. neural matrix initialized. Welcoming Sir Shakil.</span>
              </div>
            </div>

            <!-- INTERACTIVE INPUT DOCK -->
            <div class="input-dock">
              <div class="status-indicator-light" id="inputStatusIndicator"></div>
              <input type="text" class="hud-input" id="cmdInput" placeholder="Enter directive or speak freely ('Jarvis, open Chrome and set volume to 50%')..." autocomplete="off">
              <button class="hud-btn send-btn" id="btnSend">TRANSMIT</button>
            </div>

            <!-- SUGGESTION CHIPS -->
            <div class="chips-row">
              <button class="chip-cmd chip-btn" data-cmd="Jarvis, check my emails and give me an executive brief">📧 Check My Emails</button>
              <button class="chip-cmd chip-btn" data-cmd="Jarvis, optimize an Eventbrite listing for an AI masterclass">🎟️ Eventbrite SEO</button>
              <button class="chip-cmd chip-btn" data-cmd="Jarvis, generate a complete multi-channel ad campaign for my high-ticket offer">📣 Multi-Channel Ads</button>
              <button class="chip-cmd chip-btn" data-cmd="Jarvis, open dedicated browser profile">🌐 Jarvis Chrome</button>
              <button class="chip-btn" data-cmd="Jarvis, what is your best strategy to earn money for me?">💰 Earn Money Strategy</button>
              <button class="chip-cmd chip-btn" data-cmd="Jarvis, formulate a growth marketing and customer acquisition plan">📈 Growth Marketing</button>
              <button class="chip-cmd chip-btn" data-cmd="Jarvis, report full system status">System Status</button>
              <button class="chip-cmd chip-btn" data-cmd="Jarvis, conduct deep research on profitable micro SaaS tools">Research Micro-SaaS</button>
              <button class="chip-cmd chip-btn" data-cmd="Jarvis, what do you know about me?">Recall My Profile</button>
              <button class="chip-cmd chip-btn" data-cmd="Jarvis, what is your evolution level?">Evolution Stats</button>
              <button class="chip-cmd chip-btn" data-cmd="Jarvis, take a screenshot of my screen">Screenshot</button>
